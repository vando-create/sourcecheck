    "uiSchema": {
     "page1": {
      "ui:widget": "Page"
     },
     "header1": {
      "ui:widget": "Header",
      "ui:heading": "INVESTOR QUESTIONNAIRE",
      "ui:subtitle": "Northwind Credit Fund I, L.P."
     },
     "investor_name": {
      "ui:widget": "TextBox",
      "ui:formattedText": "<p>1. Name of Investor <span style=\"color: rgb(219, 55, 55);\">*</span></p>",
      "ui:pdfMapping": [
       "investor_name"
      ]
     },
     "usperson": {
      "ui:widget": "Radio",
      "ui:formattedText": "<p>2. Is the Investor a “U.S. Person”<span data-title=\"&lt;p&gt;“U.S. Person” has the meaning given in Rule 902 under the Securities Act and includes any natural person resident in the United States.&lt;/p&gt;\">FOOT_NOTE_HERE</span>?</p>",
      "ui:pdfMapping": [
       "usperson"
      ],
      "ui:multipleOption": {
       "options": [
        [
         "yes",
         {
          "pdfMappings": [
           "no_usperson"
          ],
          "formattedText": "Yes"
         }
        ],
        [
         "no",
         {
          "pdfMappings": [
           "yes_usperson"
          ],
          "formattedText": "No"
         }
        ]
       ]
      }
     },
     "accredited_intro": {
      "ui:widget": "Paragraph",
      "ui:formattedText": "<p>3. The Investor represents and warrants that it is an “accredited investor” within the meaning of Regulation S under the Securities Act and has checked the box or boxes below for each statement that applies to it.</p>"
     },
     "accredited": {
      "ui:widget": "MultipleCheckbox",
      "ui:formattedText": "<p>Please check all that apply:</p>",
      "ui:multipleOption": {
       "options": [
        [
         "networth",
         {
          "pdfMappings": [
           "networth"
          ],
          "formattedText": "The Investor’s net worth, alone or together with a spouse, exceeds $1,000,000, excluding the value of the primary residence."
         }
        ],
        [
         "income",
         {
          "pdfMappings": [
           "income"
          ],
          "formattedText": "The Investor had individual income in excess of $300,000 in each of the two most recent years and reasonably expects the same level of income in the current year."
         }
        ],
        [
         "licensed",
         {
          "pdfMappings": [
           "licensed"
          ],
          "formattedText": "The Investor holds in good standing a Series 7, Series 65 or Series 82 license."
         }
        ]
       ]
      }
     },
     "attach": {
      "ui:widget": "MultipleCheckbox",
      "ui:multipleOption": {
       "options": [
        [
         "attach",
         {
          "pdfMappings": [
           "attach"
          ],
          "formattedText": "Check this box if you wish to attach a separate sheet listing additional authorized signatories."
         }
        ]
       ]
      }
     },
     "page2": {
      "ui:widget": "Page"
     },
     "helper": {
      "ui:widget": "Paragraph",
      "ui:wellType": "Info",
      "ui:formattedText": "<p>Please answer every question on this page before continuing to the signature step.</p>"
     },
     "sourceofwealth": {
      "ui:widget": "MultipleCheckbox",
      "ui:formattedText": "<p>4. Source of Wealth (check all that apply)</p>",
      "ui:multipleOption": {
       "options": [
        [
         "salary",
         {
          "pdfMappings": [
           "salary"
          ],
          "formattedText": "Salary / bonus"
         }
        ],
        [
         "investments",
         {
          "pdfMappings": [
           "investments"
          ],
          "formattedText": "Sale of investments"
         }
        ],
        [
         "inheritance",
         {
          "pdfMappings": [
           "inheritance"
          ],
          "formattedText": "Inheritance / Gift"
         }
        ]
       ]
      }
     },
     "reject": {
      "ui:widget": "Paragraph",
      "ui:formattedText": "<p>6. The Investor acknowledges that the General Partner may reject this subscription in whole or in part in its sole discretion.</p>"
     },
     "signature": {
      "ui:widget": "Signature",
      "ui:signature": [
       {
        "mapping": "sig_investor",
        "signatureType": "Signature"
       }
      ]
     }
    }
   }
  },
